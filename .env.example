# Comma-separated Chrome profile emails allowed to open admin.html.
# This allowlist controls the local extension console only. SaaS admin APIs must
# independently verify the authenticated user and enforce the super_admin role.
VITE_SUPER_ADMIN_EMAILS=admin@example.com
VITE_PROFESSIONAL_EMAILS=member@example.com

# Public HTTPS page that authenticates the user and completes PayPal checkout.
# Keep the PayPal client secret and Orders API calls on that page's backend.
VITE_PAYPAL_CHECKOUT_URL=https://app.example.com/checkout/paypal
